root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 140

# Конвенции проекта: параметры всегда построчно, тело — по возможности на строке сигнатуры.
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 1
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 1
ktlint_function_signature_body_expression_wrapping = default

# Висячие запятые; порядок импортов как в IntelliJ.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**

# Правила, расходящиеся со стилем проекта (в основном агрессивный reflow/indent).
# Убраны из проверки, чтобы ktlint менял только то, что действительно не по формату.
ktlint_standard_indent = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_function-expression-body = disabled
ktlint_standard_blank-line-between-when-conditions = disabled
ktlint_standard_no-empty-first-line-in-method-block = disabled
ktlint_standard_no-empty-first-line-in-class-body = disabled
ktlint_standard_when-entry-bracing = disabled
ktlint_standard_function-naming = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_no-consecutive-blank-lines = disabled
ktlint_standard_no-blank-line-before-rbrace = disabled
ktlint_standard_binary-expression-wrapping = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_enum-wrapping = disabled
ktlint_standard_property-wrapping = disabled
ktlint_standard_multiline-if-else = disabled
ktlint_standard_if-else-wrapping = disabled
ktlint_standard_no-blank-line-in-list = disabled
ktlint_standard_spacing-between-declarations-with-comments = disabled
ktlint_standard_comment-wrapping = disabled

# --- Точечные исключения ---

# Кодогенераторы: длинные неразрывные строковые литералы (FQN, шаблоны).
[gen/**]
ktlint_standard_max-line-length = disabled

# Порт из Google material-color-utilities: чужой стиль, не трогаем.
[app/model/src/**/color/dynamic/**]
ktlint_standard_max-line-length = disabled
ktlint_standard_kdoc = disabled
ktlint_standard_no-consecutive-comments = disabled
ktlint_standard_backing-property-naming = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled

# Отдельные неразрывные длинные строки/сигнатуры.
[**/EditingString.kt]
ktlint_standard_max-line-length = disabled

[**/FlagInputProjector.kt]
ktlint_standard_max-line-length = disabled

[plugins/build.gradle.kts]
ktlint_standard_max-line-length = disabled

[**/Versions.kt]
ktlint_standard_max-line-length = disabled
